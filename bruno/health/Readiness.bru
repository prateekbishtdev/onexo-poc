meta {
  name: Readiness
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq ok
  res.body.checks.postgres.status: eq up
  res.body.checks.redis.status: eq up
}

docs {
  Checks Postgres and Redis. Returns 503 with status "degraded" if either is down.
}
